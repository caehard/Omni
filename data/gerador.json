  "modos": [
    {
      "id": "cenario",
      "nome": "Cenário",
      "icone": "🏞",
      "tipo": "imagem",
      "proporcao": "paisagem",
      "dica": "Lugares sem pessoas: florestas, tavernas, masmorras, cidades. Também mapas vistos de cima para usar como fundo da cena.",
      "enquadramentos": [
        {
          "id": "vista",
          "nome": "Vista do lugar",
          "prefixo": "fantasy environment concept art, wide establishing shot of",
          "sufixo": "detailed scenery, atmospheric lighting, sense of depth, no people",
          "negativo": "people, person, character, crowd, text, letters, watermark, signature, logo, frame, border, blurry, lowres, jpeg artifacts, deformed"
        },
        {
          "id": "mapa",
          "nome": "Mapa visto de cima",
          "proporcao": "quadrado",
          "prefixo": "top-down battle map, orthographic view from directly above, tabletop RPG map of",
          "sufixo": "flat even lighting, clear walkable floor, detailed ground textures, no perspective, no people",
          "negativo": "perspective, horizon, sky, isometric, people, characters, creatures, text, labels, numbers, grid lines, compass, watermark, blurry, lowres"
        }
      ]
    },
    {
      "id": "personagem",
      "nome": "Personagem",
      "icone": "🧙",
      "tipo": "personagem",
      "proporcao": "retrato",
      "dica": "Um personagem sozinho, de fundo liso: fica bom como retrato da ficha, como token e como referência para criar cenas com ele depois.",
      "enquadramentos": [
        {
          "id": "corpo",
          "nome": "Corpo inteiro",
          "prefixo": "full body character concept art of",
          "sufixo": "single character, standing, whole body visible from head to feet, centered, detailed face, detailed clothing and equipment, plain light grey background",
          "negativo": "multiple people, crowd, cropped, out of frame, cut off feet, text, watermark, signature, deformed hands, extra fingers, extra limbs, blurry, lowres, busy background"
        },
        {
          "id": "busto",
          "nome": "Busto (bom para token)",
          "proporcao": "quadrado",
          "prefixo": "head and shoulders portrait of",
          "sufixo": "single character, facing the viewer, centered, detailed face, expressive eyes, plain dark background",
          "negativo": "multiple people, cropped head, text, watermark, signature, deformed, blurry, lowres, busy background, hands"
        }
      ]
    },
    {
      "id": "cena",
      "nome": "Cenário e personagem",
      "icone": "⚔",
      "tipo": "imagem",
      "proporcao": "paisagem",
      "dica": "Personagens da biblioteca num lugar. Cite com @Nome (até 3 imagens de referência, contando um cenário opcional). Sem referência, gera uma cena qualquer.",
      "enquadramentos": [
        {
          "id": "cena",
          "nome": "Cena",
          "prefixo": "fantasy illustration, cinematic scene of",
          "sufixo": "characters interacting with the environment, dynamic composition, dramatic lighting",
          "negativo": "text, watermark, signature, frame, border, blurry, lowres, deformed, extra limbs, extra fingers, duplicated characters"
        }
      ],
      "qwen": {
        "abertura": "Create a new {estilo} illustration in {proporcao} format.",
        "personagem": "Picture {n} shows {nome}{descricao}.",
        "cenario": "Picture {n} shows the location; use it as the setting of the scene.",
        "manter": "Keep each character's face, hairstyle, body shape, clothing, colors and equipment exactly as in their picture. Each character appears only once. Lighting and perspective must match the setting.",
        "cena": "Scene: {texto}"
      }
    }
  ],
